# Copy to .env and fill in. .env is git-ignored.
AWS_PROFILE=your-profile
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Optional: route the UI through the deployed AgentCore runtime
MAMAGATE_RUNTIME_ARN=
# Optional: real pre-alerts and arrival checks
MAMAGATE_ALERT_TOPIC_ARN=
MAMAGATE_SCHEDULER_ROLE_ARN=
# Optional: S3 session persistence
MAMAGATE_SESSION_BUCKET=
# Optional: model override (default is the Strands default Bedrock model)
MAMAGATE_MODEL_ID=
# Optional: voiceover for the demo video
AETHEX_API_KEY=
