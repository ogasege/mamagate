{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PreAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:${ACCOUNT_ID}:mamagate-referral-alerts"
    },
    {
      "Sid": "ArrivalChecks",
      "Effect": "Allow",
      "Action": "scheduler:CreateSchedule",
      "Resource": "arn:aws:scheduler:us-east-1:${ACCOUNT_ID}:schedule/default/mamagate-*"
    },
    {
      "Sid": "PassSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/mamagate-scheduler-role"
    },
    {
      "Sid": "Routing",
      "Effect": "Allow",
      "Action": "geo-routes:CalculateRoutes",
      "Resource": "arn:aws:geo-routes:us-east-1::provider/default"
    },
    {
      "Sid": "Models",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:${ACCOUNT_ID}:inference-profile/*",
        "arn:aws:bedrock:*::inference-profile/*"
      ]
    },
    {
      "Sid": "Sessions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::mamagate-sessions-${ACCOUNT_ID}",
        "arn:aws:s3:::mamagate-sessions-${ACCOUNT_ID}/*"
      ]
    }
  ]
}
